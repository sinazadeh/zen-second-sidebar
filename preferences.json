      {
        "value": "inline",
        "label": "Inline"
      },
      {
        "value": "overlay",
        "label": "Overlay"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "second-sidebar.auto-hide",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "property": "second-sidebar.hide-web-panel-when-hidden",
